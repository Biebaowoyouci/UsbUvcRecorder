<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <com.serenegiant.widget.AspectRatioSurfaceView
        android:id="@+id/camera_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextureView
        android:id="@+id/gpu_camera_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <GridLayout
        android:id="@+id/multi_device_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <TextView
        android:id="@+id/no_signal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:drawablePadding="12dp"
        android:text="@string/waiting_usb"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/double_tap_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_panel"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="@string/double_tap_hint"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <com.codex.uvcrecorder.AudioLevelMeterView
        android:id="@+id/audio_level_meter"
        android:layout_width="64dp"
        android:layout_height="320dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="18dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/camera_mode_panel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingEnd="10dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/camera_adjustment_panel"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/camera_adjustment_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/camera_adjustment_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/camera_adjustment_value_one"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:visibility="gone" />

            <SeekBar
                android:id="@+id/camera_adjustment_seek_one"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/camera_adjustment_value_two"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:visibility="gone" />

            <SeekBar
                android:id="@+id/camera_adjustment_seek_two"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/camera_adjustment_action"
                style="@style/OverlayButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/camera_adjustment_close"
                style="@style/OverlayButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:text="收起" />
        </LinearLayout>

        <ScrollView
            android:layout_width="92dp"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/camera_focus_quick"
                    style="@style/OverlayButton"
                    android:layout_width="88dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:minWidth="0dp"
                    android:text="对焦" />

                <Button
                    android:id="@+id/camera_zoom_quick"
                    style="@style/OverlayButton"
                    android:layout_width="88dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:minWidth="0dp"
                    android:text="缩放" />

                <Button
                    android:id="@+id/camera_brightness_quick"
                    style="@style/OverlayButton"
                    android:layout_width="88dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:minWidth="0dp"
                    android:text="亮度" />

                <Button
                    android:id="@+id/camera_awb_quick"
                    style="@style/OverlayButton"
                    android:layout_width="88dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:minWidth="0dp"
                    android:text="白平衡" />

                <Button
                    android:id="@+id/camera_beauty_quick"
                    style="@style/OverlayButton"
                    android:layout_width="88dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:minWidth="0dp"
                    android:text="美颜" />

                <Button
                    android:id="@+id/camera_exposure_quick"
                    style="@style/OverlayButton"
                    android:layout_width="88dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:minWidth="0dp"
                    android:text="曝光" />

                <Button
                    android:id="@+id/camera_microphone_quick"
                    style="@style/OverlayButton"
                    android:layout_width="88dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:minWidth="0dp"
                    android:text="麦克风" />

                <Button
                    android:id="@+id/camera_frame_quick"
                    style="@style/OverlayButton"
                    android:layout_width="88dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:minWidth="0dp"
                    android:text="画面" />

                <Button
                    android:id="@+id/camera_format_quick"
                    style="@style/OverlayButton"
                    android:layout_width="88dp"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:text="格式" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="112dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/camera_switch_quick"
                style="@style/OverlayButton"
                android:layout_width="104dp"
                android:layout_height="56dp"
                android:text="切换镜头" />

            <Button
                android:id="@+id/camera_transmit_quick"
                style="@style/OverlayButton"
                android:layout_width="104dp"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:text="传输" />

            <Button
                android:id="@+id/camera_record_quick"
                android:layout_width="104dp"
                android:layout_height="64dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_record_red"
                android:text="录制"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/camera_settings_quick"
                style="@style/OverlayButton"
                android:layout_width="104dp"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:text="设置" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/control_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/info_panel"
            style="@style/OverlayPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/device_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_not_connected"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/signal_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/signal_placeholder"
                android:textColor="@color/accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/record_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/record_info_default"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/aux_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/aux_info_default"
                android:textColor="@color/record_orange"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/rtmp_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/rtmp_status_idle"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <HorizontalScrollView
            android:id="@+id/bottom_controls_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="1dp"
                android:orientation="horizontal">

            <Button
                android:id="@+id/device_button"
                style="@style/OverlayButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="16dp"
                android:text="@string/device_switch" />

            <Button
                android:id="@+id/multi_device_button"
                style="@style/OverlayButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="16dp"
                android:text="@string/multi_device" />

            <Button
                android:id="@+id/signal_mode_button"
                style="@style/OverlayButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="16dp"
                android:text="@string/signal_mode" />

            <Button
                android:id="@+id/main_record_button"
                android:layout_width="116dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_record_red"
                android:text="@string/record_single"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="ButtonStyle" />

            <Button
                android:id="@+id/aux_record_button"
                android:layout_width="116dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_record_orange"
                android:enabled="false"
                android:text="@string/record_aux"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:ignore="ButtonStyle" />

            <Button
                android:id="@+id/rotate_button"
                style="@style/OverlayButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:text="@string/rotate_preview" />

            <Button
                android:id="@+id/output_button"
                style="@style/OverlayButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:text="@string/hdmi_output" />

            <Button
                android:id="@+id/settings_button"
                style="@style/OverlayButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:text="@string/settings" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
